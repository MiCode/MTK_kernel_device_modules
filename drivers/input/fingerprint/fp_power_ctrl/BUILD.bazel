load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl","kernel_version",)
package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_src",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)

ddk_headers(
    name = "ddk_public_headers",
    includes = ["."],
    hdrs = glob([
        "fp_power_ctrl.h",
    ]), 
)

define_mgk_ddk_ko(
    name = "fp_power_ctrl",
    srcs = [
        "fp_power_ctrl.c",
    ],
    hdrs = glob(["**/*.h"]),
)
