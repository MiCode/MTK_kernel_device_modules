load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl","kernel_version",)
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":dummy.bzl", "dummy")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_src",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)

dummy(
    name = "dummy.c"
)

define_mgk_ddk_ko(
    name = "gt9916",
    srcs = [],
    conditional_srcs = {
        "CONFIG_TOUCHSCREEN_GT9916": {
            True: [
                "goodix_brl_fwupdate.c",
                "goodix_brl_hw.c",
                "goodix_brl_i2c.c",
                "goodix_brl_spi.c",
                "goodix_cfg_bin.c",
                "goodix_ts_core.c",
                "goodix_ts_gesture.c",
                "goodix_ts_inspect.c",
                "goodix_ts_tools.c",
                "goodix_ts_utils.c", ],
            False: [":dummy.c"],
        },
    },
    hdrs = glob(["**/*.h"]),
    header_deps = ["//kernel_device_modules-{}/drivers/input/touchscreen/xiaomi:ddk_public_headers".format(kernel_version),
            "//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:ddk_public_headers".format(kernel_version),
    ],
    includes = ["include",
		".",
    ],
    copts = [
        "-Wall",
        "-Werror",
        "-I$(DEVICE_MODULES_PATH)/drivers/gpu/drm/mediatek/mediatek_v2/",
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:mtk_disp_notify".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2:mtk_panel_ext".format(kernel_version),
        "//kernel_device_modules-{}/drivers/gpu/drm/mediatek/mediatek_v2/v1:mediatek_drm_v1".format(kernel_version),
        "//kernel_device_modules-{}/drivers/input/touchscreen/tui_common:tui-common".format(kernel_version),
        "//kernel_device_modules-{}/drivers/spi:spi-mt65xx".format(kernel_version),
        "//kernel_device_modules-{}/sound/soc/codecs/switch:switch_class".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/scp/rv:scp".format(kernel_version),
        "//kernel_device_modules-{}/drivers/input/touchscreen/xiaomi:xiaomi".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/hqsysfs:hqsysfs".format(kernel_version),
        "//kernel_device_modules-{}/drivers/soc/mediatek:mtk_tinysys_ipi".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/hq_typec/tcpc:tcpc_class".format(kernel_version),
    ],
)
