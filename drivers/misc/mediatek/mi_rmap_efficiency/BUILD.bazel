
load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl", "kernel_version")
package(
    default_visibility = [
        "//visibility:public",
    ],
)
filegroup(
    name = "srcs",
    srcs = glob([
          "**/Makefile",
          "**/Kbuild",
          "**/*.c",
          "**/*.h",
    ]),
)
filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)
ddk_headers(
    name = "ddk_public_headers",
    includes = ["."],
    hdrs = glob(["**/*.h"]), # export all headers for other modules to use
)
define_mgk_ddk_ko(
    name = "mi_rmap_efficiency",
    srcs = [
        "mi_rmap_efficiency.c",
    ],
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    header_deps = [
    ],
    ko_deps = [
    ],
    copts = [
      "-I$(srctree)/drivers/misc/mediatek/mi_rmap_efficiency",
    ],
)
