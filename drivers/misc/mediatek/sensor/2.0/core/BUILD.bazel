load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl","kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "hf_manager",
    srcs = ["hf_manager.c"],
    hdrs = [
        "hf_manager.h",
        "hf_sensor_io.h",
        "hf_sensor_type.h",
    ],
    includes = ["."],

    ko_deps = [
        "//kernel_device_modules-{}/drivers/input/touchscreen/FT3519T:ft3519t".format(kernel_version),
    ],
)

filegroup(
    name = "srcs",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)
