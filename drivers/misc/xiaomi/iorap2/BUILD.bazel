load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob([
          "**/Makefile",
          "**/Kbuild",
          "**/*.c",
          "**/*.h",
    ]),
)

ddk_headers(
	name = "headers",
	hdrs = glob(["**/*.h"]),
	includes = ["."],
	linux_includes = [
		"include",
	],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)


define_mgk_ddk_ko(
    name = "iorap2",
    srcs = [
        "launch_boost.c",
        "launch_boost_com.c",
        "launch_boost_collect.c",
        "launch_boost_preread.c",
        "launch_boost_clear.c",
        "launch_boost_flush.c",
        "launch_boost_dbg.c",
        "pte_hot_preread.c",
    ],

    hdrs = glob(["**/*.h"]),

    includes = [
	".",
    ],

    copts = [
        "-I$(srctree)/mm/"
    ],
)
