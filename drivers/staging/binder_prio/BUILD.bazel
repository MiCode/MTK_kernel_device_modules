load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
        default_visibility = [
                "//visibility:public",
        ],
)

ddk_headers(
        name = "ddk_public_headers",
        hdrs = glob(["**/*.h"]),
        includes = ["."],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

define_mgk_ddk_ko(
    name = "binder_prio",
    srcs = [
        "binder_prio.c",
    ],
    copts = [
        "-I$(srctree)/kernel/",
    ],
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    ko_deps = [],
)

