    /* LWN normal step end */

    thermal_limit_dcp = <1900 1900 1900 1900 1900 1900 1900 1900 1900 1900 1900 1900 1500 1400 1200 1000>;
    thermal_limit_qc2 = <2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2000 1500 1500 1000 500>;
    thermal_limit_qc3_18w = <2500 2500 2500 2500 2500 2500 2400 2300 2200 2100 1500 1000 800 700 600 500>;
    thermal_limit_qc3_27w = <2500 2500 2500 2500 2500 2500 2400 2300 2200 2100 1500 1000 800 700 600 500>;
    thermal_limit_qc35 = <2500 2500 2500 2500 2500 2500 2400 2300 2200 2100 1500 1000 800 700 600 500>;
    thermal_limit_pd = <17600 15000 12000 9000 8000 7000 6000 5000 4000 3500 3000 2400 2000 1500 1200 1000>;
    smart_bypass_support;
    smart_bypass_entry_soc = <20>;
    smart_bypass_exit_soc = <90>;
    smart_bypass_fallback_hyst = <5>; // board_temp(0.1 degree) hyst
    smart_bypass_forward_hyst = <5>;
    smart_bypass_high_lmt_cfg = <(-100)     250     3000
                    251     280     2500
                    281     300     2000
                    301     330     1600
                    331     370     1200
                    371     800     900>;
    smart_bypass_med_lmt_cfg = <(-100)      150     17600
                    151     200     17600
                    201     250     17600
                    251     300     8000
                    301     370     5000
                    371     800     2000>;
    smart_bypass_low_lmt_cfg = <(-100)      150     17600
                    151     200     17600
                    201     250     17600
                    251     300     17600
                    301     370     17600
                    371     800     17600>;
};

&pd_cp_manager {
		compatible = "pd_cp_manager";
		fv = <4522>;
		fv_ffc = <4572>;
		max_fcc = <17600>;
		max_vbus = <20000>;
		max_ibus = <4400>;
		fcc_low_hyst = <150>;
		fcc_high_hyst = <10>;
		low_tbat = <100>;
		high_tbat = <480>;
		high_vbat = <4400>;
		high_soc = <95>;
		low_fcc = <2000>;
		cv_vbat = <4480>;
		cv_vbat_ffc = <4510>;
		cv_ibat = <1200>;
		min_pdo_vbus = <8000>;
		max_pdo_vbus = <21000>;
		mt6375_control_gpio = <&pio 19 0x0>;
		support_4_1_mode;
		support_pmic_parachg;
		switch1_1_enter = <2500>;
		switch1_1_exit = <3700>;
		switch2_1_enter = <4200>;
		switch2_1_exit = <6500>;
		pdm_ibus_gap = <0>;
		pdm_bypass_ibus_gap = <2000>;
		adapter_power = <100>;
		fv_hyst = <9>;
		support_pchg_policy;
};

&mtk_gauge {
	disable-mtkbattery = <(1)>;
	FIXED_BATTERY_TEMPERATURE = <(25)>;
};

&mt6379_eusb2_repeater {
	mediatek,discth,cn = <0xf>;
	mediatek,equalization,cn = <0x4>;
	mediatek,intr-ofs,cn = "2";
	mediatek,pre-emphasis,cn = <0x5>;
	mediatek,rx-sqth,cn = <0x1>;
	mediatek,term-ofs,cn = "4";
	mediatek,vrt-sel,cn = <0x2>;

	status = "okay";
};

/* charger end */

/* svp start */
&mtee_svp {
	mtee: MTEE {
		compatible = "mediatek,mtk_svp_on_mtee_support";
	};

	svp: SecureVideoPath {
		compatible = "mediatek,mtk_sec_video_path_support";
	};
};

&mtkheap_page_svp {
	status = "ok";
};

&mtkheap_page_tee {
	status = "ok";
};
/* svp end */

