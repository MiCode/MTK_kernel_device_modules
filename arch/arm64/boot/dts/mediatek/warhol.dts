&pio {
	codec_en_off: codec-en-off {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			input-enable;
			bias-pull-down;
		};
	};
	codec_en_on: codec-en-on {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			output-high;
		};
	};
};

&pio {
	accdet_pins_eint_as_int: accdet-eint {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO11__FUNC_GPIO11>;
			bias-pull-up;
			input-enable;
		};
	};
};

&mmlsys2_config {
	dl-enable;
};

&disp_dpc {
	vidle-mask = <0x11>;
};


&mt6661_6_buck1 {
	regulator-always-on;
};

&mt6661_6_buck5 {
	regulator-always-on;
};

&mt6661_6_ln60_7 {
	regulator-always-on;
};

&i2c8 {
	status = "ok";
	hl7603_1@75 {
		compatible = "hl7603_1";
		reg = <0x75>;
		vout_threshold = <3000>;
		enable_toff_fast;
	};
	hl7603_2@76 {
		compatible = "hl7603_2";
		reg = <0x76>;
		vout_threshold = <3450>;
		enable_toff_fast;
	};
	hl7603_3@77 {
		compatible = "hl7603_3";
		reg = <0x77>;
		vout_threshold = <3450>;
		enable_toff_fast;
	};
};

