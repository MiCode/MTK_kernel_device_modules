&i2c5 {
	status = "ok";
	hl7603@77 {
		compatible = "hl7603";
		reg = <0x77>;
		vout_threshold = <3400>;
		enable_toff_fast;
	};
};

&mtk_gauge {
	DISABLE_MTKBATTERY = <(1)>;

	temperature-t0 = <(50)>;
	/* Battery temperature T0 */
	temperature-t1 = <(25)>;
	/* Battery temperature T1 */
	temperature-t2 = <(10)>;
	/* Battery temperature T2 */
	temperature-t3 = <(0)>;
	/* Battery temperature T3 */
	temperature-t4 = <(-10)>;
	/* Battery temperature T4 */
	temperature-t5 = <(-20)>;
	/* Battery temperature T5 */
	active-table = <(6)>;
	#include "chagall_mt6899_battery_table.dtsi"
};

&u2port0{
	mediatek,eye-vrt = <5>;
	mediatek,eye-term = <5>;
	mediatek,rev6 = <2>;
	mediatek,discth = <0xb>;
	mediatek,rx-sqth = <3>;
	mediatek,intr-ofs = "4";
	mediatek,term-ofs = "2";

	mediatek,rev6-host = <3>;
	mediatek,eye-term-host = <2>;
	mediatek,eye-vrt-host = <7>;
};

/* svp start */
&mtee_svp {
	mtee: MTEE {
		compatible = "mediatek,mtk_svp_on_mtee_support";
	};

	svp: SecureVideoPath {
		compatible = "mediatek,mtk_sec_video_path_support";
	};
};

&mtkheap_page_svp {
	status = "ok";
};

&mtkheap_region_svp {
	status = "ok";
};
/* svp end */

