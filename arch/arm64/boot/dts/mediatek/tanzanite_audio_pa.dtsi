&pio {
	sia81xx_gpio_R: sia81xx_gpio_R {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO67__FUNC_GPIO67>;
			slew-rate = <1>;
			bias-disable;
		};
	};
};

&odm {
	si_pa_L: si_pa_L{
		compatible = "si,sia81xx";
		si,si_pa_type = "sia8152x";
		si,si_pa_disable_pin = <1>;
		channel_num = <0>;
	};

	si_pa_R: si_pa_R{
		compatible = "si,sia81xx";
		si,si_pa_type = "sia81x9";
		si,si_pa_reset = <&pio 67 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia81xx_gpio_R>;
		si,si_pa_disable_pin = <0>;
		channel_num = <1>;
	};
};

&sound {
	si,sia81xx-max-num = <2>;
	si,sia81xx-aux-devs = <&si_pa_L>, <&si_pa_R>;
	si,sia81xx-aux-devs-prefix = "SpkrLeft", "SpkrRight";
};

&i2c6 {
	clock-frequency = <400000>;
	mediatek,use-open-drain;

	sipa_i2c_L: sipa_i2c_L@56{
		compatible = "si,sia81xx-i2c";
		reg = <0x56>;
		si,sipa-dev = <&si_pa_L>;
		si,sipa-addr_offset = <2>;
		status = "okay";
	};
	sipa_i2c_R: sipa_i2c_R@29{
		compatible = "si,sia81xx-i2c";
		reg = <0x29>;
		si,sipa-dev = <&si_pa_R>;
		status = "okay";
	};

	aw87xxx_pa_5B@5B {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x5B>;
		reset-gpio = <&pio 67 0>;
		dev_index = < 1 >;
		status = "okay";
	};
	aw87xxx_pa_58@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		dev_index = < 0 >;
		status = "okay";
	};
};
